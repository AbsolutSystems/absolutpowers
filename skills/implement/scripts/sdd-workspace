#!/usr/bin/env bash
# Forked from obra/superpowers `skills/subagent-driven-development/scripts/sdd-workspace`
# @ d884ae0 (tag v6.1.1, MIT License, Copyright (c) 2025 Jesse Vincent) — see VENDORED.md.
# Local delta: scratch directory moved away from the original repo-root-relative
# scratch location (see VENDORED.md for the old path) to a scratch dir under the
# feature's tasks directory, passed in via AP_TASKS_DIR (the orchestrator
# resolves this path per its own Path Resolution rules). Mechanism otherwise
# unchanged.
#
# Resolve and ensure the working-tree directory implement/SDD uses for its
# short-lived artifacts: task briefs, implementer reports, review packages,
# and the progress ledger. Print the directory's absolute path.
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# an implementer subagent from writing its report file. A self-ignoring
# .gitignore keeps the workspace out of `git status` and out of accidental
# commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so review-package
# cannot drift to a different directory.
#
# Usage: AP_TASKS_DIR=<path-to-feature-tasks-dir> sdd-workspace
set -euo pipefail

dir="${AP_TASKS_DIR:?AP_TASKS_DIR required}/.scratch"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"
cd "$dir" && pwd
